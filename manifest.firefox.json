{
  "manifest_version": 3,
  "name": "Nerdbot",
  "version": "1.1.0",
  "description": "Autonomous AI browser agent and sidebar. Multi-provider, page control, skills, local RAG.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nerdbot@savvops.local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Open Nerdbot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Nerdbot",
    "default_icon": "icons/icon48.png"
  },
  "permissions": ["storage", "identity", "activeTab", "tabs", "scripting", "cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Nerdbot Sidebar"
    },
    "open_quick_chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Quick Chat overlay on the current page"
    }
  }
}
